{"chunkId":"major-42-광고홍보학과-differentiation","majorName":"광고홍보학과","standardMajorName":"광고홍보학과","category":"사회계열","chunkType":"differentiation","content":"광고홍보학과의 차별화 키워드는 광고 기획, 브랜드, 홍보 전략, 소비자 반응이다. 언론 보도보다 브랜드와 조직의 메시지를 기획하고 대중에게 설득력 있게 전달하는 데 초점이 있다. 이 전공은 광고 기획, 브랜드 같은 주제에 관심이 있고 사람과 조직, 사회 문제를 자료와 사례로 이해하고 현실적인 해결 방향을 고민하는 활동에 끌리는 학생에게 잘 맞을 수 있다. 유사 전공과 비교했을 때 중심축이 아닌 영역은 뉴스 취재 보도, 정치 제도 연구, 회계 자료 처리이다.","keywords":["광고홍보학과","사회계열","differentiation","광고 기획","브랜드","홍보 전략","소비자 반응","의사소통","데이터분석","문제해결","구현력","정보기술","사회협력형","데이터분석형","논리탐구형","생명보건형","예술창의형","시장조사전문가","언론인","커리어넷 대학교 학과정보","exact"],"scores":{"competencyTopAxes":[{"axis":"communicationScore","label":"의사소통","score":19},{"axis":"dataAnalysisScore","label":"데이터분석","score":16},{"axis":"problemSolvingScore","label":"문제해결","score":14}],"competencyLowAxes":[{"axis":"softwareImplementationScore","label":"구현력","score":1},{"axis":"infoTechUtilizationScore","label":"정보기술","score":5}],"tendencyTopAxes":[{"axis":"socialCooperationScore","label":"사회협력형","score":29},{"axis":"dataAnalysisTypeScore","label":"데이터분석형","score":17},{"axis":"logicalInquiryScore","label":"논리탐구형","score":12}],"tendencyLowAxes":[{"axis":"bioHealthScore","label":"생명보건형","score":2},{"axis":"artCreativeScore","label":"예술창의형","score":4}]},"metadata":{"excelRowNumber":42,"sourceType":"service_json_derived_rag","datasetVersion":"2026-06-04-rag-refactor","sourceServiceDataset":"datasets/majors/major-row-42-광고홍보학과.service.json","serviceDatasetVersion":"major-service-excel-v1","serviceMetadata":{"createdAt":"2026-06-04","lastUpdated":"2026-06-04","dataType":"service_ready_quantitative_excel_only"},"descriptionSources":[{"sourceName":"커리어넷 대학교 학과정보","sourceUrl":"https://www.career.go.kr/cloud/w/major/uView?seq=54","retrievedAt":"2026-06-04","query":"광고홍보학과","matchedMajorName":"광고홍보학과","usedFor":["description"],"matchType":"exact"}],"sourceMatchTypes":["exact"],"hasSpecialSourceMatchType":false,"relatedOccupationsCount":2}}
