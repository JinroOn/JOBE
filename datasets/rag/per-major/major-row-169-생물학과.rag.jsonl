{"chunkId":"major-169-생물학과-differentiation","majorName":"생물학과","standardMajorName":"생물학과","category":"자연계열","chunkType":"differentiation","content":"생물학과의 차별화 키워드는 생물 다양성, 생태, 세포와 생화학, 생물 실험이다. 생명과학과 가까우나 생물의 구조, 분류, 생태, 실험 관찰을 폭넓게 다루는 성격이 강하다. 이 전공은 생물 다양성, 생태 같은 주제에 관심이 있고 자연 현상을 관찰하고 자료와 실험을 통해 원리를 설명하는 활동에 끌리는 학생에게 잘 맞을 수 있다. 유사 전공과 비교했을 때 중심축이 아닌 영역은 정책 집행 관리, 디자인 제작 실무, 임상 처치이다.","keywords":["생물학과","자연계열","differentiation","생물 다양성","생태","세포와 생화학","생물 실험","수리논리","데이터분석","문제해결","의사소통","구현력","논리탐구형","이론학구형","데이터분석형","예술창의형","사회협력형","생명정보학자","생물학연구원","커리어넷 대학교 학과정보","exact"],"scores":{"competencyTopAxes":[{"axis":"mathLogicalScore","label":"수리논리","score":23},{"axis":"dataAnalysisScore","label":"데이터분석","score":19},{"axis":"problemSolvingScore","label":"문제해결","score":16}],"competencyLowAxes":[{"axis":"communicationScore","label":"의사소통","score":3},{"axis":"softwareImplementationScore","label":"구현력","score":5}],"tendencyTopAxes":[{"axis":"logicalInquiryScore","label":"논리탐구형","score":27},{"axis":"theoryAcademicScore","label":"이론학구형","score":22},{"axis":"dataAnalysisTypeScore","label":"데이터분석형","score":17}],"tendencyLowAxes":[{"axis":"artCreativeScore","label":"예술창의형","score":0},{"axis":"socialCooperationScore","label":"사회협력형","score":3}]},"metadata":{"excelRowNumber":169,"sourceType":"service_json_derived_rag","datasetVersion":"2026-06-04-rag-refactor","sourceServiceDataset":"datasets/majors/major-row-169-생물학과.service.json","serviceDatasetVersion":"major-service-excel-v1","serviceMetadata":{"createdAt":"2026-06-04","lastUpdated":"2026-06-04","dataType":"service_ready_quantitative_excel_only"},"descriptionSources":[{"sourceName":"커리어넷 대학교 학과정보","sourceUrl":"https://www.career.go.kr/cloud/w/major/uView?seq=265","retrievedAt":"2026-06-04","query":"생물학과","matchedMajorName":"생물학과","usedFor":["description"],"matchType":"exact"}],"sourceMatchTypes":["exact"],"hasSpecialSourceMatchType":false,"relatedOccupationsCount":2}}
