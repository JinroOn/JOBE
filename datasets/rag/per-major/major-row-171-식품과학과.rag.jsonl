{"chunkId":"major-171-식품과학과-tendency_profile","majorName":"식품과학과","standardMajorName":"식품과학과","category":"자연계열","chunkType":"tendency_profile","content":"식품과학과의 성향 9축 기준 상위 성향은 논리탐구형 30, 이론학구형 22, 데이터분석형 20 순이다. 하위 성향은 예술창의형 1, 사회협력형 2로 기록되어 있으며, 성향 정보는 추천 설명에서 학습 방식과 관심 방향을 해석하는 보조 근거로 사용한다.","keywords":["식품과학과","자연계열","tendency_profile","식품 분석","식품 재료","가공과 안전","유기화학","수리논리","데이터분석","문제해결","의사소통","구현력","논리탐구형","이론학구형","데이터분석형","예술창의형","사회협력형","식품공학시험원","연구원","식품공학과","커리어넷 대학교 학과정보","alias"],"scores":{"competencyTopAxes":[{"axis":"mathLogicalScore","label":"수리논리","score":23},{"axis":"dataAnalysisScore","label":"데이터분석","score":18},{"axis":"problemSolvingScore","label":"문제해결","score":16}],"competencyLowAxes":[{"axis":"communicationScore","label":"의사소통","score":2},{"axis":"softwareImplementationScore","label":"구현력","score":5}],"tendencyTopAxes":[{"axis":"logicalInquiryScore","label":"논리탐구형","score":30},{"axis":"theoryAcademicScore","label":"이론학구형","score":22},{"axis":"dataAnalysisTypeScore","label":"데이터분석형","score":20}],"tendencyLowAxes":[{"axis":"artCreativeScore","label":"예술창의형","score":1},{"axis":"socialCooperationScore","label":"사회협력형","score":2}]},"metadata":{"excelRowNumber":171,"sourceType":"service_json_derived_rag","datasetVersion":"2026-06-04-rag-refactor","sourceServiceDataset":"datasets/majors/major-row-171-식품과학과.service.json","serviceDatasetVersion":"major-service-excel-v1","serviceMetadata":{"createdAt":"2026-06-04","lastUpdated":"2026-06-04","dataType":"service_ready_quantitative_excel_only"},"descriptionSources":[{"sourceName":"커리어넷 대학교 학과정보","sourceUrl":"https://www.career.go.kr/cloud/w/major/uView?seq=314","retrievedAt":"2026-06-04","query":"식품공학과","matchedMajorName":"식품공학과","usedFor":["description"],"matchType":"alias"}],"sourceMatchTypes":["alias"],"hasSpecialSourceMatchType":false,"relatedOccupationsCount":2}}
{"chunkId":"major-171-식품과학과-recommendation_reasoning","majorName":"식품과학과","standardMajorName":"식품과학과","category":"자연계열","chunkType":"recommendation_reasoning","content":"식품과학과 추천 설명을 생성할 때는 전공 설명의 핵심 내용과 차별화 포인트(식품 분석, 식품 재료, 가공과 안전, 유기화학)를 함께 참고한다. 정량 근거로는 상위 역량 항목(수리논리 23, 데이터분석 18, 문제해결 16)과 상위 성향 항목(논리탐구형 30, 이론학구형 22, 데이터분석형 20)을 사용할 수 있다. 추천 설명에서는 역량 0.6, 성향 0.4 비율의 정책을 참고하되, 점수를 새로 보정하지 않는다. 사용자의 실제 점수를 알 수 없는 상태에서는 개인별 적합도를 단정하지 않고, 전공 데이터셋이 제공하는 근거만 사용한다.","keywords":["식품과학과","자연계열","recommendation_reasoning","식품 분석","식품 재료","가공과 안전","유기화학","수리논리","데이터분석","문제해결","의사소통","구현력","논리탐구형","이론학구형","데이터분석형","예술창의형","사회협력형","식품공학시험원","연구원","식품공학과","커리어넷 대학교 학과정보","alias"],"scores":{"competencyTopAxes":[{"axis":"mathLogicalScore","label":"수리논리","score":23},{"axis":"dataAnalysisScore","label":"데이터분석","score":18},{"axis":"problemSolvingScore","label":"문제해결","score":16}],"competencyLowAxes":[{"axis":"communicationScore","label":"의사소통","score":2},{"axis":"softwareImplementationScore","label":"구현력","score":5}],"tendencyTopAxes":[{"axis":"logicalInquiryScore","label":"논리탐구형","score":30},{"axis":"theoryAcademicScore","label":"이론학구형","score":22},{"axis":"dataAnalysisTypeScore","label":"데이터분석형","score":20}],"tendencyLowAxes":[{"axis":"artCreativeScore","label":"예술창의형","score":1},{"axis":"socialCooperationScore","label":"사회협력형","score":2}]},"metadata":{"excelRowNumber":171,"sourceType":"service_json_derived_rag","datasetVersion":"2026-06-04-rag-refactor","sourceServiceDataset":"datasets/majors/major-row-171-식품과학과.service.json","serviceDatasetVersion":"major-service-excel-v1","serviceMetadata":{"createdAt":"2026-06-04","lastUpdated":"2026-06-04","dataType":"service_ready_quantitative_excel_only"},"descriptionSources":[{"sourceName":"커리어넷 대학교 학과정보","sourceUrl":"https://www.career.go.kr/cloud/w/major/uView?seq=314","retrievedAt":"2026-06-04","query":"식품공학과","matchedMajorName":"식품공학과","usedFor":["description"],"matchType":"alias"}],"sourceMatchTypes":["alias"],"hasSpecialSourceMat